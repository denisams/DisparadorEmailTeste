{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Porta": 5672,
    "Usuario": "guest",
    "Senha": "guest",
    "NomeFilaEnvio": "envio-de-emails",
    "NomeFilaMorta": "envio-de-emails.morta",
    "PrefetchCount": 20
  },
  "Smtp": {
    "Host": "localhost",
    "Porta": 1025,
    "Usuario": "",
    "Senha": "",
    "UsarSsl": false,
    "RemetentePadrao": "no-reply@disparadorteste.local",
    "TimeoutEmSegundos": 30
  },
  "LimiteDeEnvio": {
    "EmailsPorSegundo": 5,
    "TamanhoDaFilaDeEspera": 1000
  }
}
